{
  "entities": {
    "Cliente": {
      "title": "Cliente",
      "description": "Cadastro de cliente da ferramentaria",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "nome": { "type": "string", "maxLength": 200 },
        "cnpj": { "type": "string", "maxLength": 30 },
        "contato": { "type": "string", "maxLength": 100 },
        "telefone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "ativo": { "type": "boolean" },
        "criado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id", "nome", "ativo"]
    },
    "CentroCusto": {
      "title": "CentroCusto",
      "description": "Centro de custo interno ou terceirizado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "nome": { "type": "string", "maxLength": 100 },
        "codigo": { "type": "string", "maxLength": 50 },
        "origem": { "type": "string", "enum": ["interno", "terceirizado"] },
        "categoria": { "type": "string", "maxLength": 100 },
        "tipo": { "type": "string", "maxLength": 100 },
        "modelo_custo": { "type": "string", "enum": ["hora", "peca", "kg", "servico"] },
        "valor_unitario": { "type": "number" },
        "custo_hora": { "type": "number" },
        "fornecedor_nome": { "type": "string", "maxLength": 150 },
        "fornecedor_contato": { "type": "string", "maxLength": 150 },
        "prazo_padrao_dias": { "type": "number" },
        "ativo": { "type": "boolean" },
        "observacoes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "empresa_id", "nome", "origem", "categoria", "modelo_custo", "ativo"]
    },
    "Operador": {
      "title": "Operador",
      "description": "Operador fabril para registro de apontamento",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "nome": { "type": "string", "maxLength": 150 },
        "matricula": { "type": "string", "maxLength": 50 },
        "turno": { "type": "string", "maxLength": 50 },
        "ativo": { "type": "boolean" },
        "pin_hash": { "type": "string" },
        "pin_salt": { "type": "string" },
        "pin_iterations": { "type": "number" }
      },
      "required": ["id", "empresa_id", "nome", "matricula", "ativo"]
    },
    "Projeto": {
      "title": "Projeto",
      "description": "Molde ou estampo em fabricação",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "cliente_id": { "type": "string" },
        "codigo": { "type": "string", "maxLength": 50 },
        "orcamento_codigo": { "type": "string", "maxLength": 50 },
        "planejador": { "type": "string", "maxLength": 100 },
        "descricao": { "type": "string", "maxLength": 250 },
        "tipo": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Aguardando", "Em andamento", "Em tryout", "Concluído", "Cancelado"] },
        "prazo": { "type": "string" },
        "data_inicio": { "type": "string" },
        "observacoes": { "type": "string", "maxLength": 1000 },
        "criado_em": { "type": "string" },
        "atualizado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id", "cliente_id", "codigo", "descricao", "status"]
    },
    "Componente": {
      "title": "Componente",
      "description": "Peça integrante de um projeto",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "projeto_id": { "type": "string" },
        "codigo": { "type": "string", "maxLength": 50 },
        "nome": { "type": "string", "maxLength": 150 },
        "tipo": { "type": "string", "enum": ["fabricado", "comprado", "estoque"] },
        "quantidade": { "type": "number" },
        "material": { "type": "string", "maxLength": 100 },
        "dimensoes": { "type": "string", "maxLength": 100 },
        "formato": { "type": "string", "maxLength": 50 },
        "peso_kg": { "type": "number" },
        "peso_calculado": { "type": "boolean" },
        "tratamento": { "type": "string", "maxLength": 150 },
        "observacoes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Pendente", "Em produção", "Concluído", "Comprado", "Em estoque"] },
        "fornecedor": { "type": "string", "maxLength": 150 },
        "num_lista": { "type": "string", "maxLength": 50 },
        "id_refer_pai": { "type": "string", "maxLength": 50 },
        "modelo_origem_id": { "type": "string" }
      },
      "required": ["id", "empresa_id", "projeto_id", "nome", "quantidade", "material", "status"]
    },
    "Operacao": {
      "title": "Operacao",
      "description": "Etapa do roteiro de usinagem ou processo terceirizado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "componente_id": { "type": "string" },
        "centro_custo_id": { "type": "string" },
        "maquina_id": { "type": "string" },
        "sequencia": { "type": "number" },
        "descricao": { "type": "string", "maxLength": 200 },
        "horas_estimadas": { "type": "number" },
        "prazo_dias": { "type": "number" },
        "peso_kg": { "type": "number" },
        "fornecedor": { "type": "string", "maxLength": 150 },
        "valor_orcado": { "type": "number" },
        "valor_real": { "type": "number" },
        "data_envio": { "type": "string" },
        "retorno_previsto": { "type": "string" },
        "data_retorno_real": { "type": "string" },
        "documento": { "type": "string", "maxLength": 100 },
        "observacoes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Pendente", "Em andamento", "Concluída", "Enviada", "Retornada"] }
      },
      "required": ["id", "empresa_id", "componente_id", "centro_custo_id", "sequencia", "descricao", "status"]
    },
    "Apontamento": {
      "title": "Apontamento",
      "description": "Registro de tempo de usinagem do operador na máquina",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "operacao_id": { "type": "string" },
        "operador_id": { "type": "string" },
        "inicio": { "type": "string" },
        "fim": { "type": "string" },
        "editado_manualmente": { "type": "boolean" },
        "justificativa_edicao": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "empresa_id", "operacao_id", "operador_id", "inicio"]
    },
    "Usuario": {
      "title": "Usuario",
      "description": "Usuário autenticado do ToolShop ERP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "nome": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "matricula": { "type": "string", "maxLength": 50 },
        "perfil": { "type": "string", "enum": ["admin", "gerente", "lider", "operador"] },
        "ativo": { "type": "boolean" },
        "operador_id": { "type": "string" },
        "ultimo_login": { "type": "string" },
        "ultimo_acesso": { "type": "string" },
        "senha_hash": { "type": "string" },
        "senha_salt": { "type": "string" },
        "senha_iter": { "type": "number" },
        "pin_hash": { "type": "string" },
        "pin_salt": { "type": "string" },
        "pin_iter": { "type": "number" },
        "criado_em": { "type": "string" },
        "atualizado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id", "nome", "perfil", "ativo"]
    },
    "ModeloComponente": {
      "title": "ModeloComponente",
      "description": "Componente modelo com roteiro pré-definido na Biblioteca",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "codigo": { "type": "string", "maxLength": 50 },
        "nome": { "type": "string", "maxLength": 150 },
        "categoria": { "type": "string", "maxLength": 100 },
        "material": { "type": "string", "maxLength": 100 },
        "observacoes": { "type": "string", "maxLength": 500 },
        "criado_em": { "type": "string" },
        "operacoes": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["id", "empresa_id", "codigo", "nome", "categoria", "material"]
    },
    "HistoricoImportacao": {
      "title": "HistoricoImportacao",
      "description": "Log de importação de planilhas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string", "maxLength": 150 },
        "data_hora": { "type": "string" },
        "tipo": { "type": "string", "maxLength": 50 },
        "arquivo_nome": { "type": "string", "maxLength": 200 },
        "total_linhas": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "empresa_id", "usuario_id", "usuario_nome", "data_hora", "tipo", "arquivo_nome"]
    },
    "Fornecedor": {
      "title": "Fornecedor",
      "description": "Cadastro de fornecedor de matérias-primas e componentes comerciais",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "nome": { "type": "string", "maxLength": 200 },
        "contato": { "type": "string", "maxLength": 100 },
        "telefone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "prazo_padrao_dias": { "type": "number" },
        "observacoes": { "type": "string", "maxLength": 1000 },
        "ativo": { "type": "boolean" },
        "criado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id", "nome", "ativo"]
    },
    "ItemCompra": {
      "title": "ItemCompra",
      "description": "Necessidade e item de compra de matéria-prima, item comercial ou reposição de estoque",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "projeto_id": { "type": "string" },
        "componente_id": { "type": "string" },
        "item_estoque_id": { "type": "string" },
        "movimento_entrada_id": { "type": "string" },
        "movimento_entrada_ids": { "type": "array", "items": { "type": "string" } },
        "etiquetas_criadas": { "type": "array", "items": { "type": "string" } },
        "tipo": { "type": "string", "enum": ["materia_prima", "item_comercial", "reposicao"] },
        "descricao": { "type": "string", "maxLength": 250 },
        "especificacao": { "type": "string", "maxLength": 500 },
        "quantidade": { "type": "number" },
        "quantidade_recebida": { "type": "number" },
        "quantidade_pendente": { "type": "number" },
        "unidade": { "type": "string", "enum": ["un", "kg", "m", "pç"] },
        "peso_kg": { "type": "number" },
        "fornecedor_id": { "type": "string" },
        "numero_lista": { "type": "string", "maxLength": 50 },
        "data_lista": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["a_solicitar", "solicitado", "comprado", "recebido", "cancelado", "atendido_estoque"]
        },
        "data_solicitacao": { "type": "string" },
        "numero_pedido": { "type": "string", "maxLength": 100 },
        "previsao_entrega": { "type": "string" },
        "data_recebimento": { "type": "string" },
        "nota_fiscal": { "type": "string", "maxLength": 100 },
        "observacoes": { "type": "string", "maxLength": 1000 },
        "valor_estimado": { "type": "number" },
        "valor_real": { "type": "number" },
        "historico_recebimentos": { "type": "array", "items": { "type": "object" } },
        "estornado_em": { "type": "string" },
        "estornado_por": { "type": "string" },
        "estorno_movimento_ids": { "type": "array", "items": { "type": "string" } },
        "criado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id", "tipo", "descricao", "quantidade", "unidade", "status"]
    },
    "ItemEstoque": {
      "title": "ItemEstoque",
      "description": "Item de estoque, matéria-prima ou insumo controlado pelo almoxarifado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "codigo": { "type": "string", "maxLength": 100 },
        "descricao": { "type": "string", "maxLength": 300 },
        "categoria": { "type": "string", "enum": ["materia_prima", "item_comercial", "consumivel", "outro"] },
        "unidade": { "type": "string", "enum": ["un", "kg", "m", "pç"] },
        "especificacao": { "type": "string", "maxLength": 500 },
        "tipo_controle": { "type": "string", "enum": ["quantidade", "unidade_fisica"] },
        "estoque_minimo": { "type": "number" },
        "localizacao_padrao": { "type": "string", "maxLength": 100 },
        "saldo": { "type": "number" },
        "custo_medio": { "type": "number" },
        "ativo": { "type": "boolean" },
        "criado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id", "codigo", "descricao", "categoria", "unidade", "tipo_controle", "saldo", "ativo"]
    },
    "UnidadeEstoque": {
      "title": "UnidadeEstoque",
      "description": "Peça física rastreada (bloco, barra, retalho/sobra com dimensões)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "item_id": { "type": "string" },
        "etiqueta": { "type": "string", "maxLength": 100 },
        "material": { "type": "string", "maxLength": 100 },
        "formato": { "type": "string", "maxLength": 50 },
        "comprimento_mm": { "type": "number" },
        "largura_mm": { "type": "number" },
        "espessura_mm": { "type": "number" },
        "diametro_mm": { "type": "number" },
        "peso_kg": { "type": "number" },
        "custo_unitario": { "type": "number" },
        "lote_ou_certificado": { "type": "string", "maxLength": 100 },
        "localizacao": { "type": "string", "maxLength": 100 },
        "origem": { "type": "string", "enum": ["compra", "sobra", "ajuste"] },
        "origem_projeto_id": { "type": "string" },
        "origem_componente_id": { "type": "string" },
        "origem_item_compra_id": { "type": "string" },
        "numero_pedido": { "type": "string", "maxLength": 100 },
        "nota_fiscal": { "type": "string", "maxLength": 100 },
        "fornecedor_nome": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["disponivel", "reservada", "consumida", "descartada"] },
        "observacoes": { "type": "string", "maxLength": 1000 },
        "criado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id", "item_id", "etiqueta", "origem", "status"]
    },
    "MovimentoEstoque": {
      "title": "MovimentoEstoque",
      "description": "Registro imutável de movimentação (entrada, saída, ajuste) de estoque",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "item_id": { "type": "string" },
        "unidade_id": { "type": "string" },
        "tipo": { "type": "string", "enum": ["entrada", "saida", "ajuste"] },
        "quantidade": { "type": "number" },
        "data_hora": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string", "maxLength": 150 },
        "projeto_id": { "type": "string" },
        "componente_id": { "type": "string" },
        "item_compra_id": { "type": "string" },
        "numero_pedido": { "type": "string", "maxLength": 100 },
        "nota_fiscal": { "type": "string", "maxLength": 100 },
        "fornecedor_nome": { "type": "string", "maxLength": 200 },
        "movimento_estornado_id": { "type": "string" },
        "motivo": { "type": "string", "enum": ["compra", "producao", "inventario", "perda", "devolucao", "outro"] },
        "custo_unitario": { "type": "number" },
        "custo_total": { "type": "number" },
        "observacoes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "empresa_id", "item_id", "tipo", "quantidade", "data_hora", "motivo"]
    },
    "ReservaEstoque": {
      "title": "ReservaEstoque",
      "description": "Reserva de material ou peça física para componente de projeto",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "item_id": { "type": "string" },
        "unidade_id": { "type": "string" },
        "quantidade": { "type": "number" },
        "projeto_id": { "type": "string" },
        "componente_id": { "type": "string" },
        "status": { "type": "string", "enum": ["ativa", "consumida", "cancelada"] },
        "criado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id", "item_id", "quantidade", "status"]
    },
    "ConfiguracoesSistema": {
      "title": "ConfiguracoesSistema",
      "description": "Parâmetros operacionais de produção, compras e estoque do ToolShop ERP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "restringir_postos": { "type": "boolean" },
        "liberar_apenas_proxima_operacao": { "type": "boolean" },
        "avisar_operador_material_pendente": { "type": "boolean" },
        "operacoes_sem_material_recebido": { "type": "string", "enum": ["ignorar", "avisar", "bloquear"] },
        "categorias_isentas_bloqueio_material": { "type": "array", "items": { "type": "string" } },
        "permitir_saldo_negativo": { "type": "boolean" },
        "dias_alerta_reserva_parada": { "type": "number" },
        "empresa_nome": { "type": "string" },
        "empresa_cnpj": { "type": "string" },
        "empresa_endereco": { "type": "string" },
        "empresa_telefone": { "type": "string" },
        "empresa_logo": { "type": "string" },
        "atualizado_por": { "type": "string" },
        "atualizado_em": { "type": "string" }
      },
      "required": ["id", "empresa_id"]
    }
  },
  "firestore": {
    "/clientes/{clienteId}": {
      "schema": { "$ref": "#/entities/Cliente" },
      "description": "Coleção de clientes da ferramentaria"
    },
    "/centros_custo/{centroCustoId}": {
      "schema": { "$ref": "#/entities/CentroCusto" },
      "description": "Coleção de centros de custo internos e terceirizados"
    },
    "/operadores/{operadorId}": {
      "schema": { "$ref": "#/entities/Operador" },
      "description": "Coleção de operadores de máquinas"
    },
    "/projetos/{projetoId}": {
      "schema": { "$ref": "#/entities/Projeto" },
      "description": "Coleção de projetos de ferramentaria"
    },
    "/componentes/{componenteId}": {
      "schema": { "$ref": "#/entities/Componente" },
      "description": "Coleção de componentes/peças dos projetos"
    },
    "/operacoes/{operacaoId}": {
      "schema": { "$ref": "#/entities/Operacao" },
      "description": "Coleção de operações do roteiro de fabricação"
    },
    "/apontamentos/{apontamentoId}": {
      "schema": { "$ref": "#/entities/Apontamento" },
      "description": "Coleção de apontamentos de horas de usinagem"
    },
    "/usuarios/{usuarioId}": {
      "schema": { "$ref": "#/entities/Usuario" },
      "description": "Coleção de usuários e credenciais do ERP"
    },
    "/modelos_componentes/{modeloId}": {
      "schema": { "$ref": "#/entities/ModeloComponente" },
      "description": "Biblioteca padrão de modelos de componentes"
    },
    "/historico_importacoes/{historicoId}": {
      "schema": { "$ref": "#/entities/HistoricoImportacao" },
      "description": "Auditoria de importações de planilhas"
    },
    "/fornecedores/{fornecedorId}": {
      "schema": { "$ref": "#/entities/Fornecedor" },
      "description": "Coleção de fornecedores de materiais e componentes comerciais"
    },
    "/itens_compra/{itemCompraId}": {
      "schema": { "$ref": "#/entities/ItemCompra" },
      "description": "Coleção de necessidades e itens de compra"
    },
    "/itens_estoque/{itemId}": {
      "schema": { "$ref": "#/entities/ItemEstoque" },
      "description": "Coleção de itens controlados no estoque"
    },
    "/unidades_estoque/{unidadeId}": {
      "schema": { "$ref": "#/entities/UnidadeEstoque" },
      "description": "Coleção de unidades físicas e sobras rastreadas"
    },
    "/movimentos_estoque/{movimentoId}": {
      "schema": { "$ref": "#/entities/MovimentoEstoque" },
      "description": "Histórico imutável de movimentações de estoque"
    },
    "/reservas_estoque/{reservaId}": {
      "schema": { "$ref": "#/entities/ReservaEstoque" },
      "description": "Coleção de reservas ativas e históricas de estoque"
    },
    "/configuracoes/{configId}": {
      "schema": { "$ref": "#/entities/ConfiguracoesSistema" },
      "description": "Configurações operacionais de produção, compras e estoque"
    }
  }
}
