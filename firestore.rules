rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check collection for testFirestoreConnection
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Reusable validation primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'reinaldo.mafraf2@gmail.com';
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'reinaldo.mafraf2@gmail.com' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'reinaldo.mafraf2@gmail.com')
      );
    }

    // --- 1. CLIENTES ---
    function isValidCliente(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200 &&
             data.ativo is bool;
    }

    match /clientes/{clienteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(clienteId) && isValidCliente(incoming());
      allow update: if isSignedIn() && isValidId(clienteId) && isValidCliente(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(clienteId);
    }

    // --- 2. CENTROS DE CUSTO ---
    function isValidCentroCusto(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() <= 100 &&
             data.origem in ['interno', 'terceirizado'] &&
             data.modelo_custo in ['hora', 'peca', 'kg', 'servico'] &&
             data.ativo is bool;
    }

    match /centros_custo/{centroCustoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(centroCustoId) && isValidCentroCusto(incoming());
      allow update: if isSignedIn() && isValidId(centroCustoId) && isValidCentroCusto(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(centroCustoId);
    }

    // --- 3. OPERADORES ---
    function isValidOperador(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150 &&
             data.matricula is string && data.matricula.size() > 0 && data.matricula.size() <= 50 &&
             data.ativo is bool;
    }

    match /operadores/{operadorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(operadorId) && isValidOperador(incoming());
      allow update: if isSignedIn() && isValidId(operadorId) && isValidOperador(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(operadorId);
    }

    // --- 4. PROJETOS ---
    function isValidProjeto(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.cliente_id is string && data.cliente_id.size() <= 128 &&
             data.codigo is string && data.codigo.size() > 0 && data.codigo.size() <= 50 &&
             data.descricao is string && data.descricao.size() > 0 && data.descricao.size() <= 250 &&
             data.status in ['Aguardando', 'Em andamento', 'Em tryout', 'Concluído', 'Cancelado'];
    }

    match /projetos/{projetoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(projetoId) && isValidProjeto(incoming());
      allow update: if isSignedIn() && isValidId(projetoId) && isValidProjeto(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(projetoId);
    }

    // --- 5. COMPONENTES ---
    function isValidComponente(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.projeto_id is string && data.projeto_id.size() <= 128 &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150 &&
             data.quantidade is number && data.quantidade > 0 &&
             data.material is string && data.material.size() > 0 && data.material.size() <= 100 &&
             data.status in ['Pendente', 'Em produção', 'Concluído', 'Comprado', 'Em estoque'];
    }

    match /componentes/{componenteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(componenteId) && isValidComponente(incoming());
      allow update: if isSignedIn() && isValidId(componenteId) && isValidComponente(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(componenteId);
    }

    // --- 6. OPERAÇÕES ---
    function isValidOperacao(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.componente_id is string && data.componente_id.size() <= 128 &&
             data.centro_custo_id is string && data.centro_custo_id.size() <= 128 &&
             data.sequencia is number &&
             data.descricao is string && data.descricao.size() > 0 && data.descricao.size() <= 200 &&
             data.status in ['Pendente', 'Em andamento', 'Concluída', 'Enviada', 'Retornada'];
    }

    match /operacoes/{operacaoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(operacaoId) && isValidOperacao(incoming());
      allow update: if isSignedIn() && isValidId(operacaoId) && isValidOperacao(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(operacaoId);
    }

    // --- 7. APONTAMENTOS ---
    function isValidApontamento(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.operacao_id is string && data.operacao_id.size() <= 128 &&
             data.operador_id is string && data.operador_id.size() <= 128 &&
             data.inicio is string && data.inicio.size() > 0;
    }

    match /apontamentos/{apontamentoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(apontamentoId) && isValidApontamento(incoming());
      allow update: if isSignedIn() && isValidId(apontamentoId) && isValidApontamento(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(apontamentoId);
    }

    // --- 8. USUÁRIOS ---
    function isValidUsuario(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('empresa_id' in data) || (data.empresa_id is string && data.empresa_id.size() <= 128)) &&
             (!('nome' in data) || (data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150)) &&
             (!('perfil' in data) || data.perfil in ['admin', 'gerente', 'lider', 'operador']) &&
             (!('ativo' in data) || data.ativo is bool) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('matricula' in data) || data.matricula == null || (data.matricula is string && data.matricula.size() <= 50)) &&
             (!('operador_id' in data) || data.operador_id == null || (data.operador_id is string && data.operador_id.size() <= 128)) &&
             (!('ultimo_login' in data) || data.ultimo_login == null || data.ultimo_login is string) &&
             (!('ultimo_acesso' in data) || data.ultimo_acesso == null || data.ultimo_acesso is string) &&
             (!('senha_hash' in data) || data.senha_hash == null || data.senha_hash is string) &&
             (!('senha_salt' in data) || data.senha_salt == null || data.senha_salt is string) &&
             (!('senha_iter' in data) || data.senha_iter == null || data.senha_iter is number) &&
             (!('pin_hash' in data) || data.pin_hash == null || data.pin_hash is string) &&
             (!('pin_salt' in data) || data.pin_salt == null || data.pin_salt is string) &&
             (!('pin_iter' in data) || data.pin_iter == null || data.pin_iter is number) &&
             (!('criado_em' in data) || data.criado_em == null || data.criado_em is string) &&
             (!('atualizado_em' in data) || data.atualizado_em == null || data.atualizado_em is string);
    }

    match /usuarios/{usuarioId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(usuarioId) && isValidUsuario(incoming());
      allow update: if isSignedIn() && isValidId(usuarioId) && isValidUsuario(incoming());
      allow delete: if isSignedIn() && isValidId(usuarioId);
    }

    // --- 9. MODELOS DE COMPONENTES ---
    function isValidModelo(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.codigo is string && data.codigo.size() > 0 && data.codigo.size() <= 50 &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150 &&
             data.categoria is string && data.categoria.size() > 0 && data.categoria.size() <= 100 &&
             data.material is string && data.material.size() > 0 && data.material.size() <= 100;
    }

    match /modelos_componentes/{modeloId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(modeloId) && isValidModelo(incoming());
      allow update: if isSignedIn() && isValidId(modeloId) && isValidModelo(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(modeloId);
    }

    // --- 10. HISTÓRICO DE IMPORTAÇÕES ---
    function isValidHistorico(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.usuario_id is string && data.usuario_id.size() <= 128 &&
             data.usuario_nome is string && data.usuario_nome.size() > 0 && data.usuario_nome.size() <= 150 &&
             data.data_hora is string && data.data_hora.size() > 0 &&
             data.tipo is string && data.tipo.size() > 0 && data.tipo.size() <= 50 &&
             data.arquivo_nome is string && data.arquivo_nome.size() > 0 && data.arquivo_nome.size() <= 200;
    }

    match /historico_importacoes/{historicoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(historicoId) && isValidHistorico(incoming());
      allow update: if isSignedIn() && isValidId(historicoId) && isValidHistorico(incoming()) && incoming().id == existing().id;
      allow delete: if isSystemAdmin() && isValidId(historicoId);
    }

    // --- 11. VÍNCULOS OPERADOR - CENTROS DE CUSTO ---
    function isValidOperadorCentroCusto(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.operador_id is string && data.operador_id.size() <= 128 &&
             data.centro_custo_id is string && data.centro_custo_id.size() <= 128;
    }

    match /operador_centros_custo/{vinculoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(vinculoId) && isValidOperadorCentroCusto(incoming());
      allow update: if isSignedIn() && isValidId(vinculoId) && isValidOperadorCentroCusto(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(vinculoId);
    }

    // --- 12. CONFIGURAÇÕES DO SISTEMA ---
    function isValidConfiguracoes(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             (!('restringir_postos' in data) || data.restringir_postos is bool) &&
             (!('liberar_apenas_proxima_operacao' in data) || data.liberar_apenas_proxima_operacao is bool) &&
             (!('avisar_operador_material_pendente' in data) || data.avisar_operador_material_pendente is bool) &&
             (!('operacoes_sem_material_recebido' in data) || data.operacoes_sem_material_recebido in ['ignorar', 'avisar', 'bloquear']) &&
             (!('categorias_isentas_bloqueio_material' in data) || data.categorias_isentas_bloqueio_material is list) &&
             (!('permitir_saldo_negativo' in data) || data.permitir_saldo_negativo is bool) &&
             (!('dias_alerta_reserva_parada' in data) || data.dias_alerta_reserva_parada is number);
    }

    match /configuracoes/{configId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(configId) && isValidConfiguracoes(incoming());
      allow update: if isSignedIn() && isValidId(configId) && isValidConfiguracoes(incoming());
      allow delete: if isSystemAdmin() && isValidId(configId);
    }

    // --- 13. FORNECEDORES ---
    function isValidFornecedor(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200 &&
             data.ativo is bool;
    }

    match /fornecedores/{fornecedorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(fornecedorId) && isValidFornecedor(incoming());
      allow update: if isSignedIn() && isValidId(fornecedorId) && isValidFornecedor(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(fornecedorId);
    }

    // --- 14. ITENS DE COMPRA ---
    function isValidItemCompra(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             (!('projeto_id' in data) || data.projeto_id == null || (data.projeto_id is string && data.projeto_id.size() <= 128)) &&
             (!('componente_id' in data) || data.componente_id == null || (data.componente_id is string && data.componente_id.size() <= 128)) &&
             (!('item_estoque_id' in data) || data.item_estoque_id == null || (data.item_estoque_id is string && data.item_estoque_id.size() <= 128)) &&
             (!('movimento_entrada_id' in data) || data.movimento_entrada_id == null || (data.movimento_entrada_id is string && data.movimento_entrada_id.size() <= 128)) &&
             (!('quantidade_recebida' in data) || data.quantidade_recebida == null || (data.quantidade_recebida is number && data.quantidade_recebida >= 0)) &&
             (!('quantidade_pendente' in data) || data.quantidade_pendente == null || (data.quantidade_pendente is number && data.quantidade_pendente >= 0)) &&
             (!('movimento_entrada_ids' in data) || data.movimento_entrada_ids == null || data.movimento_entrada_ids is list) &&
             (!('etiquetas_criadas' in data) || data.etiquetas_criadas == null || data.etiquetas_criadas is list) &&
             (!('historico_recebimentos' in data) || data.historico_recebimentos == null || data.historico_recebimentos is list) &&
             (!('estorno_movimento_ids' in data) || data.estorno_movimento_ids == null || data.estorno_movimento_ids is list) &&
             data.tipo in ['materia_prima', 'item_comercial', 'reposicao'] &&
             data.status in ['a_solicitar', 'solicitado', 'comprado', 'recebido', 'cancelado', 'atendido_estoque'] &&
             data.quantidade is number && data.quantidade > 0 &&
             data.unidade in ['un', 'kg', 'm', 'pç'];
    }

    match /itens_compra/{itemCompraId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(itemCompraId) && isValidItemCompra(incoming());
      allow update: if isSignedIn() && isValidId(itemCompraId) && isValidItemCompra(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(itemCompraId);
    }

    // --- 15. ITENS DE ESTOQUE ---
    function isValidItemEstoque(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.codigo is string && data.codigo.size() > 0 && data.codigo.size() <= 100 &&
             data.descricao is string && data.descricao.size() > 0 && data.descricao.size() <= 300 &&
             data.categoria in ['materia_prima', 'item_comercial', 'consumivel', 'outro'] &&
             data.unidade in ['un', 'kg', 'm', 'pç'] &&
             data.tipo_controle in ['quantidade', 'unidade_fisica'] &&
             data.saldo is number &&
             data.ativo is bool;
    }

    match /itens_estoque/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(itemId) && isValidItemEstoque(incoming());
      allow update: if isSignedIn() && isValidId(itemId) && isValidItemEstoque(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(itemId);
    }

    // --- 16. UNIDADES FÍSICAS DE ESTOQUE ---
    function isValidUnidadeEstoque(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.item_id is string && data.item_id.size() <= 128 &&
             data.etiqueta is string && data.etiqueta.size() > 0 && data.etiqueta.size() <= 100 &&
             data.status in ['disponivel', 'reservada', 'consumida', 'descartada'] &&
             data.origem in ['compra', 'sobra', 'ajuste'];
    }

    match /unidades_estoque/{unidadeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(unidadeId) && isValidUnidadeEstoque(incoming());
      allow update: if isSignedIn() && isValidId(unidadeId) && isValidUnidadeEstoque(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(unidadeId);
    }

    // --- 17. MOVIMENTOS DE ESTOQUE (IMUTÁVEL: nunca são editados nem apagados) ---
    function isValidMovimentoEstoque(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.item_id is string && data.item_id.size() <= 128 &&
             data.tipo in ['entrada', 'saida', 'ajuste'] &&
             data.quantidade is number && data.quantidade > 0 &&
             data.motivo in ['compra', 'producao', 'inventario', 'perda', 'devolucao', 'outro'] &&
             data.data_hora is string && data.data_hora.size() > 0;
    }

    match /movimentos_estoque/{movimentoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(movimentoId) && isValidMovimentoEstoque(incoming());
      // IMUTÁVEL: Correções devem ser feitas exclusivamente via movimento de estorno/ajuste
      allow update, delete: if false;
    }

    // --- 18. RESERVAS DE ESTOQUE ---
    function isValidReservaEstoque(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.empresa_id is string && data.empresa_id.size() <= 128 &&
             data.item_id is string && data.item_id.size() <= 128 &&
             data.quantidade is number && data.quantidade > 0 &&
             data.status in ['ativa', 'consumida', 'cancelada'];
    }

    match /reservas_estoque/{reservaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(reservaId) && isValidReservaEstoque(incoming());
      allow update: if isSignedIn() && isValidId(reservaId) && isValidReservaEstoque(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(reservaId);
    }
  }
}

